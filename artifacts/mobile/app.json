{
  "expo": {
    "name": "Vitala AI",
    "slug": "mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080D1A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vitala.ai",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Vitala AI saves your achievement cards to your camera roll so you can share them.",
        "NSPhotoLibraryAddUsageDescription": "Vitala AI saves your achievement cards to your camera roll so you can share them."
      }
    },
    "android": {
      "package": "com.vitala.ai",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-document-picker",
      [
        "expo-media-library",
        {
          "photosPermission": "Vitala AI saves your achievement cards to your camera roll.",
          "savePhotosPermission": "Vitala AI saves your achievement cards to your camera roll.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#5B5FEF",
          "androidMode": "default",
          "androidCollapsedTitle": "Vitala AI"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "7fa94ba0-7d79-4a06-a239-1def360dbbdf"
      }
    },
    "owner": "wabitafese"
  }
}
